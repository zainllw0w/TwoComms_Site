# Шаблон конфигурации окружения для TwoComms
# Скопировать в .env и заполнить реальными значениями.
# .env находится в .gitignore — его НИКОГДА не должно быть в git.

# === Django ===
DEBUG=False
SECRET_KEY=replace-with-strong-random-50-char-string
ALLOWED_HOSTS=twocomms.shop,www.twocomms.shop

# === База данных ===
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_CONN_MAX_AGE=60

# === Redis (cache + sessions) ===
# Формат: redis://[:password]@host:port/db   или  rediss://... (TLS)
REDIS_URL=
REDIS_KEY_PREFIX=twocomms
CACHE_DEFAULT_TIMEOUT=300
REDIS_SOCKET_TIMEOUT=2.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_IGNORE_EXCEPTIONS=true

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=

# === Monobank ===
MONOBANK_TOKEN=

# === Instagram UGC intelligence ===
# Versioned HMAC keyring for the one-lifetime UGC reward identity slot.
# Keep old keys during rotation; generate secrets with a CSPRNG and use at
# least 32 bytes per value. Never use an Instagram ID or a raw user identifier.
IG_UGC_IDENTITY_HMAC_KEYRING={"v1":"replace-with-at-least-32-random-bytes"}
IG_UGC_IDENTITY_HMAC_ACTIVE_KEY_ID=v1
# shadow records qualifying evidence for manager review; auto enables only the
# deterministic high-confidence provider-owned UGC gate; disabled rejects auto.
IG_UGC_AUTO_AWARD_MODE=shadow
# Ephemeral inbound image/audio bytes must live outside MEDIA_ROOT and the
# repository. Pre-create the canonical non-symlink directory, owned by the
# worker euid with mode 0700; stored files are forced to 0600. The worker
# purges them after this bounded retention window.
IG_PRIVATE_MEDIA_ROOT=/absolute/private/path/outside/repository-and-media-root
IG_PRIVATE_MEDIA_RETENTION_SECONDS=259200

# === Email (SMTP) ===
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# === SSH deploy (НЕ хранить в файле — экспортировать в shell) ===
# Никогда не commit'ить пароли. Использовать ssh-key или ENV переменные.
# TWC_SSH_PASS=...      # будет выставлено через `export TWC_SSH_PASS=...`

# === Local MariaDB snapshot (Stage 0, placeholders only) ===
# Эти значения нужны только для scripts/sync_production_mysql.sh.
# Не вставлять сюда production host, SSH user, database name или password.
# Хранить рабочие значения в private shell env / defaults files вне Git.
TWOCOMMS_SSH_HOST=replace-with-approved-ssh-host
TWOCOMMS_SSH_USER=replace-with-approved-ssh-user
TWOCOMMS_SSH_PORT=22
TWOCOMMS_REMOTE_PROJECT=/absolute/path/to/remote/project
TWOCOMMS_REMOTE_VENV=/absolute/path/to/remote/virtualenv/bin/activate
TWOCOMMS_REMOTE_MYSQL_DEFAULTS_FILE=/absolute/path/to/private/remote-mariadb.cnf
TWOCOMMS_REMOTE_DB_NAMES=replace-with-production-default-db-name
TWOCOMMS_LOCAL_HOST=127.0.0.1
TWOCOMMS_LOCAL_PORT=3306
TWOCOMMS_LOCAL_MYSQL_DEFAULTS_FILE=/absolute/path/to/private/local-mariadb.cnf
TWOCOMMS_LOCAL_DB_PREFIX=twc_snapshot_
TWOCOMMS_SYNC_ROOT=/absolute/path/outside/repository/twocomms-db-sync
TWOCOMMS_MIN_DUMP_BYTES=10240
TWOCOMMS_SNAPSHOT_RETENTION_DAYS=14
# TWOCOMMS_DEPLOY_PASSWORD не записывать: source private deploy-env перед --apply.
